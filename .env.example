# Copy to .env for local development. Never commit real credentials.
SUPABASE_URL=https://lulmtyzgpksqnrqnloeo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-Supabase-service-role-key
PORT=8080
# Canonical origin. Production is https://www.infeara.com (no trailing slash); canonical links,
# Open Graph URLs, sitemap entries and the robots.txt Sitemap line all use it. For local work set
# SITE_BASE_URL=http://localhost:8080 and SITE_INDEXABLE=false.
SITE_BASE_URL=http://localhost:8080
# true = allow search engines to index this deployment (set on production only).
# false = send noindex headers and disallow crawling (local, staging and preview environments).
# If left empty, indexing is allowed only when SITE_BASE_URL is served over HTTPS.
SITE_INDEXABLE=false
